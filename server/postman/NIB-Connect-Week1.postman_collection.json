{
  "info": {
    "name": "NIB-Connect Authentication and Week 3 Operations",
    "description": "Authentication checks and secured NIB operator monitoring APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "email", "value": "loza@example.com" },
    { "key": "phoneNumber", "value": "+251911000001" },
    { "key": "password", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "operatorToken", "value": "" },
    { "key": "beneficiaryToken", "value": "" },
    { "key": "supplierId", "value": "" },
    { "key": "voucherId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Register beneficiary",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Demo Beneficiary\",\n  \"email\": \"{{email}}\",\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"WOMEN_STARTUP_OWNER\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registration returns success or reports an existing account', function () {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login with email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login returns a token', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.accessToken).to.be.a('string');",
              "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"unknown@example.com\",\n  \"password\": \"incorrect-password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid credentials use a generic 401', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().message).to.eql('Invalid credentials.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Current-user profile is returned without a password hash', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Current user without token",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Missing token is rejected', function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Operator access (expected forbidden for beneficiary)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/api/operator/access-check"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Beneficiary is blocked from operator access', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Week 3 Operations",
      "item": [
        {
          "name": "Dashboard summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
            "url": "{{baseUrl}}/api/ops/dashboard"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Operator dashboard is available to an operator', function () {",
                "  pm.response.to.have.status(200);",
                "  pm.expect(pm.response.json().data).to.have.property('suppliers');",
                "  pm.expect(pm.response.json().data).to.have.property('orders');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "List suppliers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
            "url": "{{baseUrl}}/api/ops/suppliers?status=unverified&page=1&limit=10"
          }
        },
        {
          "name": "Verify supplier",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Documents checked and tax details verified.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/ops/suppliers/{{supplierId}}/verify"
          }
        },
        {
          "name": "Unverify supplier",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{operatorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"Verification requires further review.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/ops/suppliers/{{supplierId}}/unverify"
          }
        },
        {
          "name": "List vouchers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
            "url": "{{baseUrl}}/api/ops/vouchers?page=1&limit=10"
          }
        },
        {
          "name": "Voucher details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
            "url": "{{baseUrl}}/api/ops/vouchers/{{voucherId}}"
          }
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
            "url": "{{baseUrl}}/api/ops/orders?page=1&limit=10"
          }
        },
        {
          "name": "Order details and timeline",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
            "url": "{{baseUrl}}/api/ops/orders/{{orderId}}"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Order monitoring does not expose OTP hashes', function () {",
                "  pm.response.to.have.status(200);",
                "  pm.expect(JSON.stringify(pm.response.json())).not.to.include('otpHash');",
                "  pm.expect(JSON.stringify(pm.response.json())).not.to.include('otpSecureHash');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Escrow summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{operatorToken}}" }],
            "url": "{{baseUrl}}/api/ops/escrow-summary"
          }
        },
        {
          "name": "Beneficiary catalog (verified suppliers only)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{beneficiaryToken}}" }],
            "url": "{{baseUrl}}/api/products?page=1&limit=10"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Catalog response contains no supplier bank details', function () {",
                "  pm.response.to.have.status(200);",
                "  pm.expect(JSON.stringify(pm.response.json())).not.to.include('bankAccountNumber');",
                "});"
              ]
            }
          }]
        }
      ]
    }
  ]
}
