generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  EU_COMPLIANCE_OFFICER
  NIB_SYSTEM_OPERATOR
  TIER1_SUPPLIER
  WOMEN_STARTUP_OWNER
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  ALLOCATED
  COMMITTED_TO_ORDER
  REDEEMED_AND_SETTLED
  CANCELLED
}

enum OrderStatus {
  PLACED
  DISPATCHED_IN_TRANSIT
  DELIVERED_PENDING_HANDSHAKE
  VERIFIED_AND_CLEARED
  CANCELLED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model User {
  id                    String              @id @default(uuid()) @db.Char(36)
  fullName              String              @db.VarChar(120)
  email                 String              @unique @db.VarChar(254)
  phoneNumber           String              @unique @db.VarChar(16)
  passwordHash          String              @db.VarChar(255)
  role                  UserRole
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  auditLogs             AuditLog[]          @relation("AuditActor")
  securityEvents        SecurityEvent[]     @relation("SecurityEventUser")
  vouchersReceived      Voucher[]           @relation("VoucherRecipient")
  vouchersAllocated     Voucher[]           @relation("VoucherAllocator")
  startupProfile        StartupProfile?
  supplierProfile       SupplierProfile?    @relation("SupplierOwner")
  supplierVerifications SupplierProfile[]   @relation("SupplierVerifier")
  handshakes            DeliveryHandshake[]
  notifications         Notification[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String   @db.VarChar(64)
  entityType String   @db.VarChar(64)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @db.Char(36)
  orderId   String?  @db.Char(36)
  ipAddress String?  @db.VarChar(45)
  eventType String   @db.VarChar(64)
  message   String   @db.VarChar(255)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

model Voucher {
  id                 String              @id @default(uuid()) @db.Char(36)
  recipientUserId    String              @db.Char(36)
  allocatedByUserId  String              @db.Char(36)
  startupId          String?             @db.Char(36)
  amount             Decimal             @db.Decimal(12, 2)
  status             VoucherStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now())
  expiresAt          DateTime?
  recipient          User                @relation("VoucherRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  allocatedBy        User                @relation("VoucherAllocator", fields: [allocatedByUserId], references: [id], onDelete: Restrict)
  startup            StartupProfile?     @relation("VoucherStartup", fields: [startupId], references: [id], onDelete: SetNull)
  committedOrder     Order?              @relation("OrderVoucher")
  escrowTransactions EscrowTransaction[]

  @@index([recipientUserId, createdAt])
  @@index([allocatedByUserId, createdAt])
  @@index([status, createdAt])
  @@index([startupId, status])
  @@map("vouchers")
}

model StartupProfile {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @unique @db.Char(36)
  businessName String    @db.VarChar(160)
  sector       String    @db.VarChar(120)
  region       String    @db.VarChar(120)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vouchers     Voucher[] @relation("VoucherStartup")
  orders       Order[]

  @@map("startup_profiles")
}

model SupplierProfile {
  id                  String    @id @default(uuid()) @db.Char(36)
  userId              String    @unique @db.Char(36)
  companyName         String    @db.VarChar(160)
  tinNumber           String    @unique @db.VarChar(40)
  discountRate        Decimal   @db.Decimal(5, 2)
  bankAccountNumber   String    @db.VarChar(64)
  address             String?   @db.Text
  contactPerson       String?   @db.VarChar(120)
  isVerified          Boolean   @default(false)
  verifiedAt          DateTime?
  verifiedById        String?   @db.Char(36)
  verificationRemarks String?   @db.VarChar(500)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation("SupplierOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy          User?     @relation("SupplierVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  products            Product[]
  orders              Order[]

  @@index([isVerified, createdAt])
  @@index([verifiedById])
  @@map("supplier_profiles")
}

model Product {
  id            String          @id @default(uuid()) @db.Char(36)
  supplierId    String          @db.Char(36)
  name          String          @db.VarChar(160)
  price         Decimal         @db.Decimal(12, 2)
  stockQuantity Int
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  supplier      SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([supplierId, isActive])
  @@map("products")
}

model Order {
  id                 String              @id @default(uuid()) @db.Char(36)
  startupId          String              @db.Char(36)
  supplierId         String              @db.Char(36)
  voucherId          String?             @unique @db.Char(36)
  grossAmount        Decimal             @db.Decimal(12, 2)
  discountApplied    Decimal             @db.Decimal(12, 2)
  netAmountToPay     Decimal             @db.Decimal(12, 2)
  status             OrderStatus         @default(PLACED)
  waybillCode        String?             @unique @db.VarChar(191)
  otpSecureHash      String?             @db.VarChar(191)
  otpExpiresAt       DateTime?
  dispatchedAt       DateTime?
  arrivedAt          DateTime?
  clearedAt          DateTime?
  cancelReason       String?             @db.VarChar(191)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  startup            StartupProfile      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  supplier           SupplierProfile     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  voucher            Voucher?            @relation("OrderVoucher", fields: [voucherId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  handshakes         DeliveryHandshake[]
  escrowTransactions EscrowTransaction[]

  @@index([startupId])
  @@index([supplierId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Char(36)
  orderId   String  @db.Char(36)
  productId String  @db.Char(36)
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model DeliveryHandshake {
  id                String   @id @default(uuid()) @db.Char(36)
  orderId           String   @db.Char(36)
  submittedByUserId String?  @db.Char(36)
  phoneNumber       String?  @db.VarChar(16)
  otpHash           String   @db.VarChar(191)
  ipAddress         String?  @db.VarChar(45)
  success           Boolean
  message           String?  @db.VarChar(191)
  attemptedAt       DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedBy       User?    @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, attemptedAt])
  @@map("delivery_handshakes")
}

model EscrowTransaction {
  id          String          @id @default(uuid()) @db.Char(36)
  orderId     String          @db.Char(36)
  voucherId   String?         @db.Char(36)
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(12, 2)
  reference   String          @unique @db.VarChar(191)
  description String          @db.VarChar(191)
  status      String          @default("SUCCESS") @db.VarChar(32)
  createdAt   DateTime        @default(now())
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  voucher     Voucher?        @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([voucherId])
  @@map("escrow_transactions")
}

model Notification {
  id              String   @id @default(uuid()) @db.Char(36)
  userId          String   @db.Char(36)
  title           String   @db.VarChar(160)
  message         String   @db.VarChar(500)
  type            String   @db.VarChar(64)
  isRead          Boolean  @default(false)
  link            String?  @db.VarChar(255)
  relatedEntityId String?  @db.VarChar(64)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, relatedEntityId])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
