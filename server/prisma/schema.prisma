generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserRole {
  EU_COMPLIANCE_OFFICER
  NIB_SYSTEM_OPERATOR
  TIER1_SUPPLIER
  WOMEN_STARTUP_OWNER
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

model User {
  id                String          @id @default(uuid()) @db.Char(36)
  fullName          String          @db.VarChar(120)
  email             String          @unique @db.VarChar(254)
  phoneNumber       String          @unique @db.VarChar(16)
  passwordHash      String          @db.VarChar(255)
  role              UserRole
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  auditLogs         AuditLog[]      @relation("AuditActor")
  securityEvents    SecurityEvent[] @relation("SecurityEventUser")
  vouchersReceived  Voucher[]       @relation("VoucherRecipient")
  vouchersAllocated Voucher[]       @relation("VoucherAllocator")

  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String   @db.VarChar(64)
  entityType String   @db.VarChar(64)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @db.Char(36)
  eventType String   @db.VarChar(64)
  message   String   @db.VarChar(255)
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_events")
}

model Voucher {
  id                String        @id @default(uuid()) @db.Char(36)
  recipientUserId   String        @db.Char(36)
  allocatedByUserId String        @db.Char(36)
  amount            Decimal       @db.Decimal(12, 2)
  status            VoucherStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  recipient         User          @relation("VoucherRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  allocatedBy       User          @relation("VoucherAllocator", fields: [allocatedByUserId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, createdAt])
  @@index([allocatedByUserId, createdAt])
  @@index([status, createdAt])
  @@map("vouchers")
}
