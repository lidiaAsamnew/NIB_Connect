datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TIER1_SUPPLIER
  WOMEN_STARTUP_OWNER
  NIB_OPERATOR
  ADMIN
}

enum OrderStatus {
  PLACED
  DISPATCHED_IN_TRANSIT
  DELIVERED_PENDING_HANDSHAKE
  VERIFIED_AND_CLEARED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(TIER1_SUPPLIER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierProfile SupplierProfile?
}

model SupplierProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  companyName       String
  tinNumber         String   @unique
  discountRate      Decimal  @db.Decimal(5, 2)
  bankAccountNumber String
  isVerified        Boolean  @default(false)
  address           String?
  contactPerson     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  supplierId    String
  name          String
  description   String?
  unitPrice     Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  supplierId      String
  startupId       String
  status          OrderStatus @default(PLACED)
  grossAmount     Decimal     @db.Decimal(12, 2)
  discountApplied Decimal     @db.Decimal(12, 2)
  netAmountToPay  Decimal     @db.Decimal(12, 2)
  waybillCode     String?     @unique
  dispatchedAt    DateTime?
  arrivedAt       DateTime?
  clearedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
